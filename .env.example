# PS5: Honest Filing Analyst — Environment Variables Template
# Copy to .env and fill in your API keys.
# NEVER commit .env to git (it's in .gitignore).

# ── Required API Keys ─────────────────────────────────────────────────────────

# Groq free-tier API key (primary LLM)
# Get yours at: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

# OpenRouter free-tier API key (fallback LLM)
# Get yours at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-YOUR_OPENROUTER_KEY_HERE

# ── LiteLLM Proxy Security ────────────────────────────────────────────────────

# Master key for LiteLLM proxy admin access (generate a strong random key)
LITELLM_MASTER_KEY=sk-ps5-master-key-change-this-in-production

# Virtual key for the app to authenticate with LiteLLM proxy
LITELLM_VIRTUAL_KEY=sk-ps5-team-key-change-this-too

# ── PostgreSQL Token Audit Database ──────────────────────────────────────────

# PostgreSQL password (used by both postgres and litellm-proxy containers)
POSTGRES_PASSWORD=litellm_secret_change_this
